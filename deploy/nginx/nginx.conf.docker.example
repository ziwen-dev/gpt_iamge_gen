# 宿主机路径：/docker/nginx/nginx.conf
# 启动挂载：
#   -v /docker/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
#   -v /docker/nginx/conf:/docker/nginx/conf:ro
#   -v /docker/nginx/html:/docker/nginx/html:ro
#
# 说明：宿主机没有 /etc/nginx 是正常的；/etc/nginx 只在容器内存在。
# 本配置在容器内加载 /docker/nginx/conf/*.conf（game.conf 等）

user  nginx;
worker_processes  auto;
error_log  /var/log/nginx/error.log notice;
pid        /run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;
    sendfile        on;
    keepalive_timeout  65;

    include /docker/nginx/conf/*.conf;
}
